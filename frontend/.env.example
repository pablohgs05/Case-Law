# Where the API answers.
#
# Published environments serve the interface and the API from the same host, so
# a relative path is enough and the image works in both — that is what the
# Dockerfile builds with.
#
# Running `npm run dev` here, the page is on port 5173 and the API is somewhere
# else, so it needs an absolute address. Either a backend you started yourself:
VITE_API_URL=http://localhost:8000
#
# ...or the published API, which needs no local backend at all:
# VITE_API_URL=https://jurisfonte.pedrohenribeiro.com/api
