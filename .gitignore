# Environment — never commit real credentials.
# The .env.example template IS versioned, so anyone can set up their own.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Node / frontend
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Coverage reports, written by the test runners on every run and read by
# SonarQube. Regenerated, never reviewed, and the HTML one alone is 70 files.
coverage/

# The ADK dev panel keeps one session database per agent. It holds whatever was
# typed into the panel, so it is local by definition.
.adk/

# Data files — the pipeline output does not belong in git
*.dump
*.sqlite3
data/raw/
data/processed/

# Editors and OS
.claude/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
